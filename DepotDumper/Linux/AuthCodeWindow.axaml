<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DepotDumper.Linux.AuthCodeWindow"
        Title="Steam Guard"
        Width="380" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22" Spacing="10">
        <TextBlock Text="Steam Guard code required" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Text="That code was not accepted. Enter the current code." Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="False"/>
        <TextBox x:Name="CodeBox" FontSize="22" HorizontalContentAlignment="Center" MaxLength="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Submit" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
