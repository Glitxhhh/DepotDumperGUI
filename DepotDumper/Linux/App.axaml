<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DepotDumper.Linux"
             x:Class="DepotDumper.Linux.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Linux/Themes/Dark.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Ties Fluent's own accent-driven controls (ToggleSwitch, focus rings, selection) to the same blue as the rest of the app -->
            <Color x:Key="SystemAccentColor">#FF6F8FFF</Color>
            <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,monospace</FontFamily>
            <local:LogLevelBrushConverter x:Key="LogLevelBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="/Linux/Themes/Controls.axaml"/>
    </Application.Styles>
</Application>
