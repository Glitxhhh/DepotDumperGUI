<Window x:Class="DepotDumper.GUI.AuthCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Guard"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Steam Guard code required" Style="{StaticResource Heading}" FontSize="18" Margin="0,0,0,8"/>

        <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" Grid.Row="2"
                   Text="That code was not accepted. Enter the current code."
                   Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <TextBox x:Name="CodeBox" Grid.Row="3"
                 FontSize="26" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                 HorizontalContentAlignment="Center" MaxLength="10"
                 CharacterCasing="Upper" Padding="8,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="OkButton" Content="Submit" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButton}" Padding="26,9"/>
        </StackPanel>
    </Grid>
</Window>
