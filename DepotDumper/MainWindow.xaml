<Window x:Class="DepotDumper.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DepotDumper.GUI"
        mc:Ignorable="d"
        Title="DepotDumper - Morrenus Edition"
        Height="950" Width="1000"
        MinHeight="900" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FF2B2B2B"
        SizeToContent="Manual">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="#FF0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0063B1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF555555"/>
                    <Setter Property="Foreground" Value="#FF999999"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF1E1E1E" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="DepotDumper - Morrenus Edition" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Steam Depot Manifest Downloader" FontSize="12" Foreground="#FFAAAAAA" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Login Settings -->
                <GroupBox Header="Steam Login">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameTextBox" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" Margin="0,10,0,0"/>
                        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="5,10,5,0"
                                     Padding="5" Background="#FF3C3C3C" Foreground="White"
                                     BorderBrush="#FF555555" BorderThickness="1"/>

                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,10,0,0">
                            <CheckBox x:Name="RememberPasswordCheckBox" Content="Remember Password" Margin="0,0,20,0"/>
                            <CheckBox x:Name="UseQrCodeCheckBox" Content="Use QR Code Login"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- App Settings -->
                <GroupBox Header="Application Settings">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="App ID(s):"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AppIdTextBox"
                                 Margin="5" ToolTip="Enter App IDs separated by commas (leave empty to process all licensed apps)"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dump Directory:" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DumpDirectoryTextBox"
                                 Text="dumps" Margin="5,10,5,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." x:Name="BrowseButton"
                                Click="BrowseButton_Click" Margin="0,10,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Excluded App IDs:" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExcludedAppIdsTextBox"
                                 Margin="5,10,5,0" ToolTip="Enter App IDs to exclude, separated by commas"/>

                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,10,0,0">
                            <CheckBox x:Name="DownloadManifestsCheckBox" Content="Download Manifests (.manifest files)"
                                      IsChecked="True" ToolTip="Uncheck to create Lua-only dumps" Margin="0,0,0,5"/>
                            <CheckBox x:Name="PublicOnlyCheckBox" Content="Public Branches Only"
                                      IsChecked="False" ToolTip="Only download public branch (skip beta/private branches)"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Advanced Settings -->
                <GroupBox Header="Advanced Settings">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Downloads:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MaxDownloadsTextBox"
                                 Text="4" Margin="5"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Max Servers:" Margin="10,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="MaxServersTextBox"
                                 Text="20" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cell ID:" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CellIDTextBox"
                                 Text="0" Margin="5,10,5,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Login ID:" Margin="10,10,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="LoginIDTextBox"
                                 Margin="5,10,5,0" ToolTip="Optional - for concurrent instances"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max Concurrent Apps:" Margin="0,10,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxConcurrentAppsTextBox"
                                 Text="1" Margin="5,10,5,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Log Level:" Margin="10,10,0,0"/>
                        <ComboBox Grid.Row="2" Grid.Column="3" x:Name="LogLevelComboBox"
                                  Margin="5,10,5,0" SelectedIndex="1"
                                  Background="#FF3C3C3C" Foreground="White"
                                  BorderBrush="#FF555555">
                            <ComboBoxItem Content="Debug"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Error"/>
                            <ComboBoxItem Content="Critical"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Log Output -->
                <GroupBox Header="Output Log">
                    <TextBox x:Name="LogTextBox" Height="150"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             Margin="5"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Control Panel -->
        <Border Grid.Row="2" Background="#FF1E1E1E" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="LoadConfigButton" Content="Load Config" Click="LoadConfigButton_Click" Margin="0,0,10,0"/>
                    <Button x:Name="SaveConfigButton" Content="Save Config" Click="SaveConfigButton_Click"/>
                </StackPanel>

                <ProgressBar Grid.Column="1" x:Name="ProgressBar" Height="25" Margin="10,0"
                             Background="#FF3C3C3C" BorderBrush="#FF555555" BorderThickness="1"/>

                <TextBlock Grid.Column="2" x:Name="StatusTextBlock" Text="Ready" Margin="10,0"
                           FontWeight="SemiBold"/>

                <Button Grid.Column="3" x:Name="StartButton" Content="Start Dump"
                        Click="StartButton_Click" Margin="10,0" Width="120"/>

                <Button Grid.Column="4" x:Name="StopButton" Content="Stop"
                        Click="StopButton_Click" IsEnabled="False" Width="80"
                        Background="#FFCC0000"/>
            </Grid>
        </Border>
    </Grid>
</Window>
