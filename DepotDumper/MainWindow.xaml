<Window x:Class="DepotDumper.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DepotDumper.GUI"
        Title="Depot Dumper GUI"
        Width="1220" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <local:CountLabelConverter x:Key="CountLabel"/>
        <ContextMenu x:Key="LibraryRowMenu">
            <MenuItem Header="Show manifest in Explorer" Click="LibShowInExplorer_Click"/>
            <MenuItem Header="Copy manifest ID" Click="LibCopyManifestId_Click"/>
            <MenuItem Header="Copy depot ID" Click="LibCopyDepotId_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="LuaRowMenu">
            <MenuItem Header="Open in default program" Click="LuaOpen_Click"/>
            <MenuItem Header="Show in Explorer" Click="LuaShowInExplorer_Click"/>
            <MenuItem Header="Copy file path" Click="LuaCopyPath_Click"/>
        </ContextMenu>
        <!-- Header of one app's group in the libraries: a click expands or collapses the rows under it -->
        <Style x:Key="GroupHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource CountLabel}">
                                            <Binding Path="ItemCount"/>
                                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubGroupHeaderToggle" TargetType="ToggleButton" BasedOn="{StaticResource GroupHeaderToggle}">
            <Setter Property="Padding" Value="38,7,16,7"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style x:Key="SubGroupItem" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="GroupHeader" Style="{StaticResource SubGroupHeaderToggle}" Loaded="GroupHeader_Loaded" Click="GroupHeader_Click"/>
                            <ItemsPresenter x:Name="GroupRows" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="GroupHeader" Property="IsChecked" Value="True"><Setter TargetName="GroupRows" Property="Visibility" Value="Visible"/></Trigger>
                            <!-- an app without DLC has one unnamed sub-group: no header, its rows are simply there -->
                            <DataTrigger Binding="{Binding Name}" Value="">
                                <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="GroupRows" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppGroupItem" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="GroupHeader" Style="{StaticResource GroupHeaderToggle}" Loaded="GroupHeader_Loaded" Click="GroupHeader_Click"/>
                            <ItemsPresenter x:Name="GroupRows" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="GroupHeader" Property="IsChecked" Value="True"><Setter TargetName="GroupRows" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF7C9BFF" Offset="0"/>
                                <GradientStop Color="#FF9B6BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Depot Dumper" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Text="GUI" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLibrary" GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Manifest library" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLua" GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE943;" Content="Lua library" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLogs" GroupName="nav" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Logs" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border x:Name="AccountChip" Style="{StaticResource Card}" Padding="14,12" Background="{DynamicResource Surface2Brush}" CornerRadius="12"
                            Cursor="Hand" MouseLeftButtonUp="AccountChip_Click" ToolTip="Switch account">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarDot" Width="9" Height="9" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SidebarStatus" Text="Idle" FontWeight="SemiBold" Margin="9,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SidebarAccount" Text="No account set" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AccountChip}" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                        <Border Style="{StaticResource Card}" Padding="8" Width="208" CornerRadius="12" Margin="6"
                                Background="{DynamicResource SurfaceBrush}">
                            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="ACCOUNTS" Style="{StaticResource FieldLabel}" Margin="10,4,0,6"/>
                                <StackPanel x:Name="AccountList"/>
                                <Button Content="+  Add account" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0"
                                        Padding="10,8" Click="AddAccount_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <CheckBox x:Name="DarkModeToggle" Content="Dark mode" Margin="8,16,0,0" Checked="DarkMode_Changed" Unchecked="DarkMode_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Column="1" Margin="30,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Graceful-shutdown warning -->
            <Border x:Name="ShutdownBanner" Grid.Row="1" Visibility="Collapsed" Margin="0,-4,0,16" Padding="16,12" CornerRadius="12"
                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarnBrush}" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Shutting down gracefully — this takes a moment" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" MaxWidth="820"
                                   Text="The dumper is finishing the downloads already running so nothing is left half-written. Force shutdown quits immediately, but any half-written file is simply re-downloaded next run."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource Heading}"/>
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" CornerRadius="16" Padding="13,7" Margin="0,0,14,0" Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Idle" FontWeight="SemiBold" Margin="8,0,0,0" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Padding="22,10" Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock x:Name="StartButtonText" Text="Start dump"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" Padding="22,10" Margin="0,0,10,0" Visibility="Collapsed" Click="PauseButton_Click"
                            ToolTip="Pause: nothing new starts, work already running finishes. Resume continues.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseButtonIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock x:Name="PauseButtonText" Text="Pause"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Padding="22,10" Visibility="Collapsed" Click="StopButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock Text="Stop"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ForceButton" Style="{StaticResource DangerButton}" Padding="22,10" Visibility="Collapsed" Click="ForceButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="13" Margin="0,0,9,0"/>
                            <TextBlock Text="Force shutdown"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pages -->
            <Grid Grid.Row="2">

                <!-- ===== Dashboard ===== -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="APPS" Style="{StaticResource FieldLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="StatAppsValue" Text="0" Style="{StaticResource StatValue}" Margin="0,10,0,2"/>
                                    <TextBlock x:Name="StatAppsCaption" Text="waiting to start" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="DEPOTS" Style="{StaticResource FieldLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="StatDepotsValue" Text="0" Style="{StaticResource StatValue}" Margin="0,10,0,2"/>
                                    <TextBlock x:Name="StatDepotsCaption" Text="finished" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="MANIFESTS" Style="{StaticResource FieldLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="StatManifestsValue" Text="0" Style="{StaticResource StatValue}" Margin="0,10,0,2"/>
                                    <TextBlock x:Name="StatManifestsCaption" Text="downloaded this run" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{DynamicResource WarnBrush}"/><TextBlock Text="TO DOWNLOAD" Style="{StaticResource FieldLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <TextBlock x:Name="StatHistoryValue" Text="0" Style="{StaticResource StatValue}" Margin="0,10,0,2"/>
                                    <TextBlock x:Name="StatHistoryCaption" Text="known manifest IDs not downloaded yet" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Progress" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="ElapsedText" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="RunProgress" Margin="0,14,0,10" Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="ProgressText" Text="Nothing running. Configure your account in Settings, then press Start dump." Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="SpeedText" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{DynamicResource FaintBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.35*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <Button x:Name="CollectNowButton" Content="Collect luas &amp; manifests now" Click="CollectNow_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                                    <Button x:Name="ScanLocalButton" Content="Scan local files for manifests" Click="ScanLocal_Click" Margin="0,0,0,8"/>
                                    <Button Content="Open dumps folder" Click="OpenDumps_Click" Margin="0,0,0,8"/>
                                    <Button Content="Open manifests pool" Click="OpenManifestPool_Click" Margin="0,0,0,8"/>
                                    <Button Content="Open luas pool" Click="OpenLuaPool_Click" Margin="0,0,0,8"/>
                                    <Button Content="Send manifests to Steam" Click="SendToSteam_Click" Margin="0,0,0,8" ToolTip="Copies dumps\manifests into Steam's depotcache folder"/>
                                    <Button Content="Export all keys…" Click="ExportKeys_Click" Margin="0,0,0,8" ToolTip="Writes every depot key you have dumped into one depotId;key file"/>
                                    <Button Content="Export access tokens…" Click="ExportTokens_Click" ToolTip="Writes the app and package access tokens saved during your dumps (app.tokens, package.tokens)"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <ListBox x:Name="ActivityList" Height="248">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Manifest library ===== -->
                <Grid x:Name="PageLibrary" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                            <StackPanel><TextBlock Text="KNOWN" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="LibKnown" Text="0" Style="{StaticResource StatValue}" FontSize="24"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                            <StackPanel><TextBlock Text="DOWNLOADED" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="LibDownloaded" Text="0" Style="{StaticResource StatValue}" FontSize="24" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18,14">
                            <StackPanel><TextBlock Text="PENDING" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="LibPending" Text="0" Style="{StaticResource StatValue}" FontSize="24" Foreground="{DynamicResource WarnBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="18,14">
                            <StackPanel><TextBlock Text="UNAVAILABLE" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="LibUnavailable" Text="0" Style="{StaticResource StatValue}" FontSize="24" Foreground="{DynamicResource DangerBrush}"/></StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,24,12"
                                           Text="Every manifest ID the dumper sees is remembered here, so older versions stay downloadable for downgrading. Steam has no list of past versions, so add IDs by scanning your own files, importing a list, or just letting runs accumulate them."/>
                                <TextBlock x:Name="IndexHint" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" Margin="0,-4,24,12" Visibility="Collapsed"/>
                                <CheckBox x:Name="HistoryToggle" Content="Download known historical manifests during dump runs" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Scan local files" Click="ScanLocal_Click" Margin="0,0,8,0"/>
                                <Button Content="Import ID list…" Click="ImportIds_Click" Margin="0,0,8,0"/>
                                <Button Content="Retry unavailable" Click="RetryUnavailable_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="16,14,16,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LibrarySearch" Tag="Search app, depot or manifest ID" TextChanged="LibrarySearch_Changed"/>
                                <TextBlock x:Name="LibraryCount" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>

                            <!-- Downgrade helper -->
                            <Border Grid.Row="1" Margin="16,0,16,12" Padding="14,10" CornerRadius="10" Background="{DynamicResource Surface2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Downgrade helper" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DowngradeHint" Style="{StaticResource Caption}" Margin="0,2,12,0"
                                                   Text="Select one or more downloaded manifests below (Ctrl / Shift to pick several), then copy the commands to install that version."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Steam console" Padding="12,7" Margin="0,0,8,0" Click="CopySteamConsole_Click"
                                                ToolTip="Copies download_depot commands. Open steam://open/console and paste."/>
                                        <Button Content="DepotDownloader" Padding="12,7" Margin="0,0,8,0" Click="CopyDepotDownloader_Click"
                                                ToolTip="Copies DepotDownloader command lines"/>
                                        <Button Content="Save .bat" Padding="12,7" Margin="0,0,8,0" Click="SaveBat_Click"/>
                                        <Button Content="Verify folder…" Padding="12,7" Margin="0,0,8,0" Click="VerifyFolder_Click"
                                                ToolTip="Checks a game folder against the ONE selected manifest (file sizes and SHA-1). Read-only."/>
                                        <Button Content="Download version…" Padding="12,7" Click="DownloadVersion_Click"
                                                ToolTip="Downloads the selected version straight from Steam's servers using your saved depot keys and manifests. No Steam login or game ownership needed."/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="LibraryGrid" Grid.Row="2" SelectionMode="Extended" SelectionChanged="LibraryGrid_SelectionChanged" Tag="manifest|manifests" IsSynchronizedWithCurrentItem="False"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" EnableRowVirtualization="True">
                                <DataGrid.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource AppGroupItem}"/>
                                    <GroupStyle ContainerStyle="{StaticResource SubGroupItem}"/>
                                </DataGrid.GroupStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick"/>
                                        <Setter Property="ContextMenu" Value="{StaticResource LibraryRowMenu}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                                    <DataGridTextColumn Header="APP" Binding="{Binding App}" Width="90"/>
                                    <DataGridTextColumn Header="DEPOT" Binding="{Binding Depot}" Width="100"/>
                                    <DataGridTextColumn Header="MANIFEST ID" Binding="{Binding Manifest}" Width="190"/>
                                    <DataGridTextColumn Header="BRANCHES" Binding="{Binding Branches}" Width="*"/>
                                    <DataGridTextColumn Header="CREATED" Binding="{Binding CreatedText}" Width="130"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Lua library ===== -->
                <Grid x:Name="PageLua" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,24,0" VerticalAlignment="Center"
                                       Text="Every lua in your pooled luas folder, read from disk. Select one to see what's inside, copy it, or save copies elsewhere. Nothing here changes your files."/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh" Click="LuaRefresh_Click" Margin="0,0,8,0"/>
                                <Button Content="Open luas folder" Click="OpenLuaPool_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="16,14,16,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LuaSearch" Tag="Search app ID, name or problem (e.g. &quot;no depot keys&quot;)" TextChanged="LuaSearch_Changed"/>
                                <TextBlock x:Name="LuaCount" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid x:Name="LuaGrid" SelectionMode="Extended" SelectionChanged="LuaGrid_SelectionChanged" Tag="lua|luas" IsSynchronizedWithCurrentItem="False"
                                          VirtualizingPanel.IsVirtualizingWhenGrouping="True" EnableRowVirtualization="True">
                                    <DataGrid.GroupStyle><GroupStyle ContainerStyle="{StaticResource AppGroupItem}"/></DataGrid.GroupStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_RightClick"/>
                                            <Setter Property="ContextMenu" Value="{StaticResource LuaRowMenu}"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="APP" Binding="{Binding App}" Width="80"/>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="VARIANT" Binding="{Binding Variant}" Width="90"/>
                                        <DataGridTextColumn Header="KEYS" Binding="{Binding Keys}" Width="60"/>
                                        <DataGridTextColumn Header="DLC" Binding="{Binding Others}" Width="60"/>
                                        <DataGridTextColumn Header="MANIFESTS" Binding="{Binding Manifests}" Width="100"/>
                                        <DataGridTextColumn Header="NEWEST MANIFEST" Binding="{Binding NewestText}" Width="140"/>
                                        <DataGridTextColumn Header="NOTES" Binding="{Binding Issues}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12,16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="LuaViewerTitle" Text="Select a lua to preview it" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="Copy" Click="LuaCopy_Click" Margin="0,0,8,0" ToolTip="Copies the selected lua's text"/>
                                            <Button Content="Save copies…" Click="LuaSave_Click" ToolTip="Saves the selected lua(s) into a folder you choose"/>
                                        </StackPanel>
                                        <TextBox x:Name="LuaViewer" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <!-- ===== Settings ===== -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Steam account" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>
                                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="QrToggle" Content="Sign in with a QR code instead" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="StaySignedInToggle" Content="Stay signed in (remember login token)" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="SavePasswordToggle" Content="Remember password on this PC" Margin="0,0,0,4"/>
                                    <TextBlock Text="Encrypted so only your Windows account can read it. Turn off to keep it in memory only." Style="{StaticResource Caption}" Margin="50,0,0,0"/>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SessionText" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <Button x:Name="ForgetSessionButton" Grid.Column="1" Content="Forget login" Padding="12,6" Margin="12,0,0,0"
                                                    Visibility="Collapsed" Click="ForgetSession_Click"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="A Steam Guard code prompt appears whenever Steam asks for one." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="What to dump" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="ONLY THESE APP IDS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AppIdsBox" Margin="0,0,0,4"/>
                                    <TextBlock Text="Comma separated. Leave empty to dump every app you own." Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                                    <TextBlock Text="SKIP THESE APP IDS" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ExcludedBox" Margin="0,0,0,14"/>
                                    <TextBlock Text="BRANCHES" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BranchAll" GroupName="branch" Style="{StaticResource SegmentButton}" Content="All branches"/>
                                        <RadioButton x:Name="BranchPublic" GroupName="branch" Style="{StaticResource SegmentButton}" Content="Public only"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Manifests" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="DownloadManifestsToggle" Content="Download manifest files" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="KeepOldToggle" Content="Keep older manifests when a newer one downloads" Margin="0,0,0,4"/>
                                    <TextBlock Text="Existing manifests are checked (structure and SHA-256) and reused instead of re-downloaded." Style="{StaticResource Caption}" Margin="50,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Collection" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Pools every lua and manifest (including ones inside zips) into dumps\luas and dumps\manifests, without duplicates." Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="CollectAfterToggle" Content="Collect automatically after each run" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CollectPublicToggle" Content="Public branch only" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CollectNoBetaToggle" Content="Skip beta / preview branches" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CollectLatestToggle" Content="Newest lua per game only" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="CollectDepotCacheToggle" Content="Also pool manifests from Steam's depotcache"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Performance" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="DynamicToggle" Content="Dynamic speed (auto-adjust)" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="50,0,0,14"
                                               Text="Runs several depots at once, speeding up while Steam responds well and your PC has room, and easing off on rate limits, errors or high CPU / RAM. Off = one depot at a time. 'Max parallel depots' below is the ceiling."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="MAX PARALLEL DEPOTS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxParallelDepotsBox" Margin="0,0,0,12"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="PARALLEL APPS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxConcurrentAppsBox" Margin="0,0,0,12"/></StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="MAX SERVERS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxServersBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="CELL ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CellIdBox"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="LOGIN ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LoginIdBox"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="MANIFESTS PER DEPOT" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxDownloadsBox"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="MEMORY LIMIT (GB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxMemoryBox" Tag="auto"/></StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                               Text="Memory limit caps this app's own RAM use; leave empty for automatic (it slows down on its own when your PC runs low)."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <TextBlock Text="DUMP DIRECTORY" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="DumpDirBox" TextChanged="DumpDirBox_TextChanged"/>
                                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                                        <Button Grid.Column="2" Content="Move…" Margin="8,0,0,0" Click="MoveDumps_Click"
                                                ToolTip="Move everything already dumped to a new (empty) folder and switch to it"/>
                                    </Grid>
                                    <TextBlock x:Name="DumpDirResolved" Style="{StaticResource Caption}" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="SETTINGS &amp; LOGIN" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="SettingsLocationText" Style="{StaticResource Caption}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                    <CheckBox x:Name="PortableToggle" Content="Portable mode (keep everything next to the exe)" Margin="0,0,0,4"
                                              Checked="PortableToggle_Changed" Unchecked="PortableToggle_Changed"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="50,0,0,16"
                                               Text="Off: settings and login live in your user profile (AppData) and survive moving or updating the exe. On: they stay beside the exe, so the whole folder can go on a USB stick."/>
                                    <TextBlock Text="LOG DETAIL" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <RadioButton x:Name="LogLevelDebug" GroupName="loglevel" Style="{StaticResource SegmentButton}" Content="Debug"/>
                                        <RadioButton x:Name="LogLevelInfo" GroupName="loglevel" Style="{StaticResource SegmentButton}" Content="Info"/>
                                        <RadioButton x:Name="LogLevelWarning" GroupName="loglevel" Style="{StaticResource SegmentButton}" Content="Warning"/>
                                        <RadioButton x:Name="LogLevelError" GroupName="loglevel" Style="{StaticResource SegmentButton}" Content="Error"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Import settings…" Click="LoadConfig_Click" Margin="0,0,8,0"/>
                                        <Button Content="Export settings…" Click="SaveConfig_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ===== Logs ===== -->
                <Grid x:Name="PageLogs" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="FilterAll" GroupName="logfilter" Style="{StaticResource SegmentButton}" Content="All" IsChecked="True" Checked="LogFilter_Changed"/>
                            <RadioButton x:Name="FilterInfo" GroupName="logfilter" Style="{StaticResource SegmentButton}" Content="Info +" Checked="LogFilter_Changed"/>
                            <RadioButton x:Name="FilterWarn" GroupName="logfilter" Style="{StaticResource SegmentButton}" Content="Warnings +" Checked="LogFilter_Changed"/>
                            <RadioButton x:Name="FilterError" GroupName="logfilter" Style="{StaticResource SegmentButton}" Content="Errors" Checked="LogFilter_Changed"/>
                        </StackPanel>
                        <TextBox x:Name="LogSearch" Grid.Column="1" Margin="8,0,16,0" Tag="Filter log lines…" TextChanged="LogSearch_Changed"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="AutoScrollToggle" Content="Auto-scroll" IsChecked="True" Margin="0,0,16,0"/>
                            <Button Content="Clear" Click="ClearLog_Click" Margin="0,0,8,0"/>
                            <Button Content="Open log folder" Click="OpenLogs_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
                        <ListBox x:Name="LogList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66"/><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Foreground="{DynamicResource FaintBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="DEBUG"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARNING"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="CRITICAL"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
